<resources>
    <!-- Site Map: setup -->
    <string name="site_title">Mapa do site</string>
    <string name="site_setup_intro">Defina o site e depois percorra os racks pressionando o botão IP Report de cada minerador. A captura sempre começa no Prédio 1, Rack 1, Nível 1, Posição 1 (extremo esquerdo), preenche cada nível da esquerda→direita, depois o nível acima, depois o próximo rack.</string>
    <string name="site_name_label">Nome do site (usado em Salvar na fazenda)</string>
    <string name="site_buildings">Prédios</string>
    <string name="site_racks_per_building">Racks por prédio</string>
    <string name="site_tiers_per_rack">Níveis por rack (prateleiras)</string>
    <string name="site_positions_per_tier">Posições por nível (mineradores por fileira)</string>
    <string name="site_setup_summary">%1$d slots no total — %2$d por rack, %3$d por prédio.</string>
    <string name="site_supported_models">Modelos suportados</string>
    <string name="site_supported_models_body">A captura escuta o broadcast do botão IP Report (UDP 14235): Bitmain Antminer (era S9 a S21) com firmware de fábrica, Braiins OS e LuxOS. O app devolve um ack para o minerador piscar verde quando o toque é registrado. WhatsMiner, Canaan e Bitaxe/ESP-Miner não enviam esse broadcast — preencha os slots deles com Manual. O celular precisa estar no Wi-Fi da LAN dos mineradores (broadcasts não cruzam roteadores nem o Tailscale).</string>
    <string name="site_start_capture">Iniciar captura</string>


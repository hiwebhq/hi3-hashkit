    <!-- Heatmap -->
    <string name="site_heatmap_title">Mapa de calor</string>
    <string name="site_heatmap_empty">Ningún minero tiene aún ubicación de rack. Ejecuta Mapa del sitio (o define una ubicación como B1-R1-T1-P1 en el diálogo Editar de un minero) y los racks aparecerán aquí, coloreados por temperatura de chip en vivo.</string>

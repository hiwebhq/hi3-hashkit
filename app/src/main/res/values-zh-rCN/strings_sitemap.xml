    <!-- Site Map: setup -->
    <string name="site_title">站点地图</string>
    <string name="site_setup_intro">先定义站点，然后沿机架巡走并按下每台矿机的 IP Report 按钮。录入始终从 1 号建筑、1 号机架、第 1 层、1 号位（最左端）开始，每层从左到右填满，再上一层，再下一个机架。</string>
    <string name="site_name_label">站点名称（用于“保存到矿场”）</string>
    <string name="site_buildings">建筑数</string>
    <string name="site_racks_per_building">每栋建筑的机架数</string>
    <string name="site_tiers_per_rack">每个机架的层数（隔板）</string>
    <string name="site_positions_per_tier">每层的位数（每行矿机数）</string>
    <string name="site_setup_summary">共 %1$d 个槽位——每机架 %2$d 个，每栋建筑 %3$d 个。</string>
    <string name="site_supported_models">支持的机型</string>
    <string name="site_supported_models_body">录入监听 IP Report 按钮的广播（UDP 14235）：原厂固件的 Bitmain Antminer（S9 至 S21 时代）、Braiins OS 和 LuxOS。应用会回送确认，矿机在按键被记录时会闪绿灯。WhatsMiner、Canaan 和 Bitaxe/ESP-Miner 不发送此广播——请用“手动”填充它们的槽位。手机必须连接矿机所在局域网的 Wi-Fi（广播不会跨路由器或 Tailscale）。</string>
    <string name="site_start_capture">开始录入</string>


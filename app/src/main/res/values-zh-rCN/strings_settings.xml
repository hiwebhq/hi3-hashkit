    <!-- Advanced features -->
    <string name="set_advanced_unlocked_desc">高级功能已解锁。这会在仪表盘菜单中显示“比特币实况”链接；未来版本可能会把更多内容移到这里（安全页面、高级工具）。</string>
    <string name="set_advanced_locked_desc">输入解锁码以显示高级功能（目前为仪表盘菜单的“比特币实况”链接）。</string>
    <string name="set_advanced_unlock_code_optional">解锁码（可选）</string>
    <string name="set_advanced_unlock_code">解锁码</string>
    <string name="set_advanced_apply_code">应用解锁码</string>

    <!-- Alerts -->
    <string name="set_alerts_title">告警与通知</string>
    <string name="set_alerts_subtitle">离线、温度、风扇、拒绝率和重启告警，并附恢复通知。</string>
    <string name="set_alert_hashrate_below" formatted="false">算力低于（预期的 %）时告警</string>
    <string name="set_alert_chip_temp">芯片温度告警（°C）</string>
    <string name="set_alert_vr_temp">VR 温度告警（°C）</string>
    <string name="set_alert_reject_rate" formatted="false">拒绝率告警（%）</string>
    <string name="set_alert_cooldown">重复通知冷却时间（分钟）</string>

    <!-- Discovery -->
    <string name="set_discovery_extra_subnets">额外扫描子网（CIDR，逗号分隔）</string>
    <string name="set_discovery_subnets_hint">添加可通过你的 Tailscale 子网路由访问的远程局域网，例如 192.168.50.0/24。它们会在添加页面显示为快捷填充选项。</string>

    <!-- Display -->
    <string name="set_theme">主题</string>
    <string name="set_theme_system">跟随系统</string>
    <string name="set_theme_dark">深色</string>
    <string name="set_theme_light">浅色</string>
    <string name="set_ui_theme">界面主题</string>
    <string name="set_ui_theme_hint">应用全局的强调色。状态颜色（在线/离线）不受影响。</string>
    <string name="set_profit_card_title">收益与能耗卡片</string>
    <string name="set_profit_card_subtitle">在仪表盘上显示预计收入、电费和能耗。</string>
    <string name="set_solo_card_title">Solo 爆块概率卡片</string>
    <string name="set_solo_card_subtitle">在仪表盘上显示找到区块的概率。</string>
    <string name="set_card_order_title">仪表盘卡片顺序</string>
    <string name="set_card_order_hint">调整仪表盘各模块的顺序——例如把矿池和 MMP 移到矿机列表下方。卡片仍只在对应功能开启时显示。</string>
    <string name="set_inventory_tag_title">资产标签</string>
    <string name="set_inventory_tag_hint">机队表格显示哪种制作标签按钮，用于给矿机贴标。</string>
    <string name="set_tag_qr">QR</string>
    <string name="set_tag_nfc">NFC</string>
    <string name="set_tag_both">两者</string>
    <string name="set_pause_on_exit_title">退出时确认</string>
    <string name="set_pause_on_exit_subtitle">点按退出按钮时显示“退出 Hi3 Hashkit？”确认框。</string>

    <!-- Farms -->
    <string name="set_manage_farms">管理矿场…</string>
    <string name="set_default_farm">默认矿场</string>
    <string name="set_default_farm_hint">将仪表盘固定到某个矿场：矿场选择行会隐藏，只显示该矿场的矿机——单站点运营时布局更紧凑。</string>
    <string name="set_all_farms">所有矿场</string>

    <!-- Hi3 MMP -->
    <string name="set_mmp_title">Hi3 MMP 机队视图</string>
    <string name="set_mmp_subtitle">来自你的 Mining Management Platform 的只读机队概览和按站点汇总。</string>
    <string name="set_mmp_url">MMP URL</string>
    <string name="set_mmp_key_saved">API 密钥（已保存——输入以替换，留空以清除）</string>
    <string name="set_mmp_key_hint">API 密钥（在 MMP 管理界面中生成）</string>
    <string name="set_mmp_replace_key">替换密钥</string>
    <string name="set_mmp_save_key">保存密钥</string>
    <string name="set_mmp_disclosure">启用期间传输的内容：你的 MMP API 密钥置于请求头中，经 HTTPS 发送到上方的 MMP URL，应用打开时约每分钟一次——只读机队查询，不上传任何数据。密钥使用 Android Keystore 加密存储。默认关闭。</string>

    <!-- Local web server -->
    <string name="set_web_server_title">开放 Web 仪表盘 + /metrics</string>
    <string name="set_web_server_subtitle">运行一个本地只读 Web 服务器：局域网内任何浏览器或电视都能打开的 HTML 机队仪表盘，外加供 Grafana 使用的 Prometheus /metrics 端点。无认证——仅限私有局域网/tailnet 使用。</string>
    <string name="set_web_server_port">端口</string>
    <string name="set_web_server_hint">应用打开期间：仪表盘位于 http://&lt;本机-IP>:%1$d/，指标位于 /metrics。只读（仅 GET）；提供总量和单机数据，无控制功能。</string>

    <!-- Monitoring -->
    <string name="set_bg_monitoring_title">后台监控</string>
    <string name="set_bg_monitoring_subtitle">应用关闭时约每 15 分钟轮询一次（Android 可能延迟；这不是持续的实时监控）。</string>
    <string name="set_refresh_interval">刷新间隔</string>
    <string name="set_default_refresh_interval">默认刷新间隔</string>
    <string name="set_farm_refresh_hint">查看某个矿场时按该矿场自己的间隔刷新；无活动矿场时使用默认间隔。</string>
    <string name="set_keep_history">历史保留（天）</string>
    <string name="set_fw_check_title">检查固件更新</string>
    <string name="set_fw_check_subtitle">需自行开启：检查 GitHub 上的 AxeOS（Bitaxe）发布版本并标记落后的矿机。应用不做刷机；关闭时不会联网。</string>
    <string name="set_auto_recover_title">自动恢复离线矿机</string>
    <string name="set_auto_recover_subtitle">矿机离线超过阈值时，对其智能插座断电重启（如已配置）或重启矿机——仅一次，并有冷却时间。每次尝试都有审计记录。</string>
    <string name="set_auto_recover_after">离线多久后恢复（分钟）</string>
    <string name="set_safety_title">常驻安全监控</string>
    <string name="set_safety_subtitle">即使应用关闭，也在后台运行智能插座超温断电（带常驻通知），并在手机重启后重新生效。仅当你为矿机设置了插座断电时才有用。</string>

    <!-- MQTT / Home Assistant -->
    <string name="set_mqtt_title">发布到 MQTT</string>
    <string name="set_mqtt_subtitle">将机队及单机遥测发送到本地 MQTT 代理（例如 Home Assistant 的 Mosquitto 插件）。需自行开启；仅发送总量和单机算力/功耗/温度——不含地址或凭据。</string>
    <string name="set_mqtt_host">代理主机</string>
    <string name="set_mqtt_port">代理端口</string>
    <string name="set_mqtt_topic">基础主题</string>
    <string name="set_mqtt_username">用户名（可选）</string>
    <string name="set_mqtt_password_saved">密码（已保存——输入以替换，留空以清除）</string>
    <string name="set_mqtt_password_optional">密码（可选）</string>
    <string name="set_mqtt_replace_password">替换密码</string>
    <string name="set_mqtt_save_password">保存密码</string>
    <string name="set_mqtt_ha_title">Home Assistant 发现</string>
    <string name="set_mqtt_ha_subtitle">发布 MQTT 发现配置，让矿机自动显示为 HA 设备/实体。</string>
    <string name="set_mqtt_disclosure">应用打开期间每次轮询发布一次。密码使用 Android Keystore 加密存储。可将 Prometheus/HA 指向此代理。</string>

    <!-- Pool -->
    <string name="set_pool_stats_title">矿池统计</string>
    <string name="set_pool_stats_subtitle">矿池侧矿工数据的只读视图，并在仪表盘上与本地矿机读数关联对比。</string>
    <string name="set_pool_coming_soon">%1$s 支持即将推出。其 API 需先验证才会发送任何数据，因此该矿池目前不会联网——请选择其他矿池以加载实时统计。</string>
    <string name="set_pool_url">矿池 URL</string>
    <string name="set_pool_access_token">访问令牌</string>
    <string name="set_pool_api_token">API 密钥 / 观察者令牌（可选）</string>
    <string name="set_pool_disclosure">启用期间传输的内容：你的%1$s（以及已设置的令牌），置于发往 %2$s 的 HTTPS 请求中，应用打开时约每分钟一次。除此之外别无其他——不含矿机遥测、本地 IP 或矿工密码。默认关闭；关闭后所有矿池请求立即停止。</string>
    <string name="set_pool_label">矿池</string>

    <!-- Push (webhook) -->
    <string name="set_push_intro">将告警镜像到你自己的推送服务，应用关闭时也能收到——我们不设云账户。仅对活动告警触发。</string>
    <string name="set_push_service">推送服务</string>
    <string name="set_push_ntfy_url">ntfy 主题 URL（https://ntfy.sh/your-topic）</string>
    <string name="set_push_gotify_url">Gotify 服务器 URL</string>
    <string name="set_push_gotify_token">Gotify 应用令牌</string>
    <string name="set_push_telegram_token">Telegram 机器人令牌</string>
    <string name="set_push_telegram_chat">Telegram 会话 ID</string>
    <string name="set_push_generic_url">POST URL（JSON 请求体）</string>

    <!-- Quiet hours & digest -->
    <string name="set_quiet_hours_title">安静时段</string>
    <string name="set_quiet_hours_subtitle">在每晚指定时段内不发送告警通知。告警仍会记录，并出现在每日摘要中。</string>
    <string name="set_quiet_from">开始（HH:MM）</string>
    <string name="set_quiet_until">结束（HH:MM）</string>
    <string name="set_digest_title">每日摘要</string>
    <string name="set_digest_subtitle">每天一条汇总通知，涵盖过去 24 小时的告警。</string>
    <string name="set_digest_time">摘要时间（小时，0–23）</string>

    <!-- Security -->
    <string name="set_app_lock_title">应用锁</string>
    <string name="set_app_lock_subtitle_available">打开应用需要指纹/面容或设备 PIN（后台超过 1 分钟后重新锁定）。</string>
    <string name="set_app_lock_subtitle_unavailable">不可用：请先在本设备上设置屏幕锁（PIN/生物识别）。</string>
    <string name="set_app_lock_note">保护应用界面。注意：导出的备份和磁盘上的数据库由 Android 标准应用沙盒保护，而非此锁。</string>


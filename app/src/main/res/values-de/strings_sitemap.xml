    <!-- Heatmap -->
    <string name="site_heatmap_title">Heatmap</string>
    <string name="site_heatmap_empty">Noch kein Miner hat einen Rack-Standort. Führe den Standortplan aus (oder setze im Bearbeiten-Dialog eines Miners einen Standort wie B1-R1-T1-P1), dann erscheinen die Racks hier, gefärbt nach Live-Chip-Temperatur.</string>
